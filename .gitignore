# [Ll]ibrary directory is generated by Unity
[Ll]ibrary/

# [Tt]emp folder is generated by Unity
[Tt]emp/

# [Oo]bj folder is generated by Unity
[Oo]bj/

# [Bb]uild and [Bb]uilds folders are conventionally used for build outputs
[Bb]uild/
[Bb]uilds/

# [Ll]ogs folder is generated by Unity
[Ll]ogs/

# [Mm]emoryCaptures folder is generated by Unity
[Mm]emoryCaptures/

# [Uu]ser[Ss]ettings folder is generated by Unity
[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when the asset itself is ignored!
!*[Oo]bj/AssetServerTemplate*
!*[Ll]ibrary/Env*
!*[Ll]ibrary/ServerPreferences*

